[sub_resource type="GDScript" id="GDScript_5vw27"]
script/source = "extends Node3D

var bullet = preload(\"res://minecraft/bullit.tscn\")
@onready var pos: Node3D = $Node3D

func _physics_process(delta: float) -> void:
	if Input.is_action_just_pressed(\"click\"):
		var init = bullet.instantiate()
		init.global_transform = pos.global_transform
		get_tree().current_scene.add_child(init)
"

